<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DraftZero.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <!-- F-003：全局文本框纸面化（普通/悬停/焦点三态），覆盖 Fluent 焦点态的近黑背景 -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        </Style>

        <!-- F-010：列表选择用档案鼠尾草色，替换 Fluent 系统蓝 -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="2,1" />
        </Style>
        <Style Selector="ListBoxItem /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- F-004：思源黑体 Medium（Source Han Sans CN，OFL）应用级字体；缺失时回退系统黑体 -->
            <FontFamily x:Key="AppFontFamily">
                app:///Assets/Fonts/SourceHanSansCN-Medium.otf#Source Han Sans CN, Microsoft YaHei UI, Segoe UI, PingFang SC
            </FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 深色：夜间档案（D-001，产品决定：Windows 预览版固定深色，不随系统切换）。 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#242C2A" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#303A34" />
                    <SolidColorBrush x:Key="RailBrush" Color="#29332D" />
                    <SolidColorBrush x:Key="RaisedBrush" Color="#39463E" />
                    <SolidColorBrush x:Key="SelectedBrush" Color="#435344" />
                    <SolidColorBrush x:Key="TextBrush" Color="#EFF0E7" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#C3CCC2" />
                    <SolidColorBrush x:Key="RuleBrush" Color="#59665C" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#E1C993" />
                    <SolidColorBrush x:Key="ConfirmedBrush" Color="#A9D1B1" />
                    <SolidColorBrush x:Key="RemoteBrush" Color="#CFBCE0" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#F0A89E" />
                    <SolidColorBrush x:Key="FocusBrush" Color="#E1C993" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
