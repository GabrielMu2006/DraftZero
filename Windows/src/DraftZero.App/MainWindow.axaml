<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DraftZero.App.Views"
        x:Class="DraftZero.App.MainWindow" x:CompileBindings="False"
        DragDrop.AllowDrop="True"
        Title="Draft Zero —— 无限草稿室"
        Width="1180" Height="760" MinWidth="820" MinHeight="620"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid ColumnDefinitions="210,*">
        <!-- 索引脊背 -->
        <Border Grid.Column="0" Background="{DynamicResource RailBrush}">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="18,20,18,8">
                    <TextBlock Text="DRAFT ZERO" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="索引档案 · 本机优先" FontSize="11.5"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="10,6">
                    <StackPanel x:Name="NavList" Spacing="2" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="10,8,10,14" Spacing="2">
                    <Separator Background="{DynamicResource RuleBrush}" Margin="4,2,4,8" />
                    <Border x:Name="NavSettings" CornerRadius="6" Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="06" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="设置" FontSize="13.5" Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主工作区 -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" />

            <!-- 导入批次结果浮层（R-001 逐项报告） -->
            <Border x:Name="ImportOverlay" IsVisible="False" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="16" Width="380" CornerRadius="10"
                    Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="1" BoxShadow="0 4 16 0 #44000000" ZIndex="50">
                <StackPanel Margin="14" Spacing="8">
                    <TextBlock Text="导入结果" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <ItemsControl x:Name="ImportList" ItemsSource="{Binding ImportItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                        Padding="9,7" Margin="0,2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayStatus}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Button Content="另存新快照" FontSize="11" Padding="6,2"
                                                IsVisible="{Binding IsDuplicate}"
                                                HorizontalAlignment="Left"
                                                Click="OnImportAnyway" Tag="{Binding Id}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="关闭" Padding="10,4" Click="OnCloseImportOverlay" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 添加链接浮层（R-002） -->
            <views:AddLinkSheet x:Name="AddLinkSheet" IsVisible="False" ZIndex="60" />

            <!-- 仓库文件勾选浮层 -->
            <views:RepoBrowseSheet x:Name="RepoBrowseSheet" IsVisible="False" ZIndex="60" />

            <!-- 快速搜索浮层（Ctrl+K） -->
            <views:QuickSearchSheet x:Name="QuickSearchSheet" IsVisible="False" ZIndex="60" />

            <!-- 归入项目浮层 -->
            <views:JoinProjectSheet x:Name="JoinProjectSheet" IsVisible="False" ZIndex="60" />

            <!-- 合并草稿浮层 -->
            <views:MergeSheet x:Name="MergeSheet" IsVisible="False" ZIndex="60" />

            <!-- 深链写入确认（W-009：拒绝零写入） -->
            <views:DeepLinkConfirmSheet x:Name="DeepLinkConfirmSheet" IsVisible="False" ZIndex="70" />
        </Grid>
    </Grid>
</Window>
